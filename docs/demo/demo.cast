[0.161, "o", "\r\n\u001b[34mΔ main.rs\r\n────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[9;1H─────┐\r\n•\u001b[39m \u001b[34m1\u001b[39m: \u001b[34m│\r\n─────┘\r\n\u001b[32m// A tiny program for the tabden demo.\r\n\u001b[35mfn\u001b[39m \u001b[34mmain\u001b[39m() {\r\n\u001b[48;2;63;0;1m    let device = \"\u001b[48;2;144;16;17mtablet\u001b[48;2;63;0;1m\";\u001b[K\r\n\u001b[48;2;0;40;0m    \u001b[35mlet\u001b[39m device \u001b[35m=\u001b[39m \u001b[32m\"\u001b[48;2;0;96;0mphone\u001b[48;2;0;40;0m\"\u001b[39m;\u001b[K\r\n\u001b[49m    println!(\u001b[32m\"Hello from my \u001b[33m{device}\u001b[32m!\"\u001b[39m);\r\n}\r\n"]
